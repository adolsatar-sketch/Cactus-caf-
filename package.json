{
  "name": "cactus-cafe-menu",
  "private": true,
  "version": "1.0.0",
  "description": "Cactus Café — trilingual (AR / KU / EN) digital menu. React + Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "audit": "node scripts/audit.mjs",
    "prebuild": "node scripts/audit.mjs --check",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/almarai": "^5.2.0",
    "@fontsource/lobster": "^5.2.0",
    "@fontsource/noto-sans-arabic": "^5.2.0",
    "@fontsource/roboto": "^5.2.0",
    "gsap": "^3.12.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
